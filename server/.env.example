PORT=5000
NODE_ENV=development

# Local MongoDB option:
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
# Atlas option: replace with the SRV URI from Atlas > Connect > Drivers.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ai-mystery-room?retryWrites=true&w=majority

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=
CLIENT_URL=http://localhost:5173
